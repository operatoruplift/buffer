# Server-only mainnet RPC with getProgramAccounts and getMultipleAccounts support.
# Leave blank for deterministic samples and Pacifica public API reads.
# Pacifica requires no API key. This RPC is used for Velocity, legacy Drift, and Jupiter inventory.
SOLANA_RPC_URL=
# Optional: public authority with active Velocity positions, for manual live verification.
BUFFER_TEST_AUTHORITY=
# Optional cloud accounts. Public keys only; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after SMTP, allowed redirects, and email confirmation/recovery are verified.
NEXT_PUBLIC_AUTH_EMAIL_READY=false
# Optional path for the durable local SQLite mock worker. Defaults to .local/alerts.sqlite.
# BUFFER_ALERT_STORE=
# Optional server-only distributed read-limit secret. Requires the protected consume_rate_limit RPC.
# If unconfigured/unreachable, only per-process limits apply. Never use a NEXT_PUBLIC_ prefix.
# RATE_LIMIT_SECRET=
# Optional setup-only credentials. These are never read by the application.
# SUPABASE_ACCESS_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SENDER_EMAIL=

# Hosted monitoring: server-only credentials, deliberately separate from browser auth.
# Store only SHA-256 of BUFFER_ALERT_WORKER_SECRET in private.buffer_monitor_credentials.
# BUFFER_ALERT_WORKER_SECRET=
# CRON_SECRET=
BUFFER_ALERT_SEND_ENABLED=false
BUFFER_ALERT_NOTIFICATION_MODE=test
# Server-admin Discord destinations. See docs/DISCORD-ALERTS.md for exact JSON schema.
# BUFFER_DISCORD_DESTINATIONS_JSON=[]
